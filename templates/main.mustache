{{!
    @template block_timetable/main

    The Timetable block. block_timetable/main replaces the content for another view, day or page.

    Data attributes required for JS:
    * data-region="block_timetable", data-instanceid, data-contextid, data-courseid

    Example context (json):
    {
        "instanceid": 4,
        "contextid": 52,
        "courseid": 1,
        "defaulteventcontext": 1,
        "view": "today",
        "time": 1761688800,
        "horizontal": false,
        "interactive": true,
        "showviews": true,
        "views": [
            {"view": "today", "name": "Today", "active": true},
            {"view": "thisweek", "name": "This week", "active": false},
            {"view": "nextxday", "name": "Upcoming", "active": false}
        ],
        "showdays": false,
        "days": [],
        "events": [
            {
                "id": 7,
                "name": "Assignment 1 is due",
                "formattedtime": "Today, 17:00",
                "viewurl": "https://example.com/calendar/view.php?view=day&time=1761750000#event_7",
                "normalisedeventtype": "course",
                "source": "Maths &amp; Physics",
                "ended": false
            }
        ],
        "showpagination": false,
        "previous": 0,
        "next": 0
    }
}}
<div class="block-timetable" data-region="block_timetable" data-instanceid="{{instanceid}}" data-contextid="{{contextid}}" data-courseid="{{courseid}}">
    {{> block_timetable/content }}
</div>
{{#interactive}}
{{#js}}
require(['block_timetable/main'], function(Main) {
    Main.init({{instanceid}});
});
{{/js}}
{{/interactive}}
