{{!
    @template block_timetable/content

    The content of a Timetable block: view selector, days of the week, events and pagination.

    Data attributes required for JS:
    * data-region="content", data-view, data-time
    * data-action="block_timetable-show" with data-view, data-time and data-page on the buttons

    Example context (json):
    {
        "defaulteventcontext": 1,
        "view": "thisweek",
        "time": 1761688800,
        "horizontal": true,
        "showviews": true,
        "views": [
            {"view": "today", "name": "Today", "active": false},
            {"view": "thisweek", "name": "This week", "active": true}
        ],
        "showdays": true,
        "days": [
            {"name": "Mon", "fullname": "Monday, 27 October", "time": 1761519600, "today": false, "past": true, "active": false},
            {"name": "Tue", "fullname": "Tuesday, 28 October", "time": 1761606000, "today": true, "past": false, "active": true}
        ],
        "events": [],
        "showpagination": true,
        "previous": 1,
        "next": 3
    }
}}
<div data-region="content" data-view="{{view}}" data-time="{{time}}">
    {{#showviews}}
    <div class="btn-group btn-group-sm d-flex mb-2" role="group" aria-label="{{#str}} views, block_timetable {{/str}}">
        {{#views}}
        <button type="button" class="btn {{#active}}btn-secondary{{/active}}{{^active}}btn-outline-secondary{{/active}}" data-action="block_timetable-show" data-view="{{view}}" aria-pressed="{{#active}}true{{/active}}{{^active}}false{{/active}}">{{name}}</button>
        {{/views}}
    </div>
    {{/showviews}}
    {{#showdays}}
    <div class="timetable-days d-flex mb-2" role="group" aria-label="{{#str}} days, block_timetable {{/str}}">
        {{#days}}
        <button type="button" class="timetable-day{{#today}} today{{/today}}{{#past}} past{{/past}}{{#active}} active{{/active}}" data-action="block_timetable-show" data-view="thisweek" data-time="{{time}}" title="{{fullname}}" aria-label="{{fullname}}" aria-pressed="{{#active}}true{{/active}}{{^active}}false{{/active}}">{{name}}</button>
        {{/days}}
    </div>
    {{/showdays}}
    <div class="timetable calendarwrapper {{#horizontal}}horizontal{{/horizontal}}{{^horizontal}}vertical{{/horizontal}}" data-context-id="{{defaulteventcontext}}">
        {{#events}}
            {{> block_timetable/event }}
        {{/events}}
        {{^events}}
            <p class="text-muted mb-0">{{#str}} noevents, block_timetable {{/str}}</p>
        {{/events}}
    </div>
    {{#showpagination}}
    <nav class="d-flex mt-1" aria-label="{{#str}} pagination, block_timetable {{/str}}">
        {{#previous}}
        <button type="button" class="btn btn-link btn-sm px-0" data-action="block_timetable-show" data-view="{{view}}" data-time="{{time}}" data-page="{{previous}}">&laquo; {{#str}} previous, block_timetable {{/str}}</button>
        {{/previous}}
        {{#next}}
        <button type="button" class="btn btn-link btn-sm px-0 ml-auto ms-auto" data-action="block_timetable-show" data-view="{{view}}" data-time="{{time}}" data-page="{{next}}">{{#str}} next, block_timetable {{/str}} &raquo;</button>
        {{/next}}
    </nav>
    {{/showpagination}}
</div>
